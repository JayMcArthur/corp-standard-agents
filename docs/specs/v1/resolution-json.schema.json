{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-agents.local/schemas/resolution-json-v1.schema.json",
  "title": "team-agents resolution.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace",
    "git_root",
    "normalized_remotes",
    "matched_repo_id",
    "matched_repo_group_id",
    "binding_name",
    "profile",
    "repo_class",
    "layer_chain",
    "applied_layers",
    "enabled_sources",
    "source_details",
    "enabled_skills",
    "active_policies",
    "active_docs",
    "active_contracts",
    "active_packs",
    "active_flows",
    "active_profiles",
    "recommended_items",
    "recommended_agent_types",
    "warnings",
    "selected_profile_configs",
    "items",
    "denied_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["v1"]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "git_root": {
      "type": ["string", "null"]
    },
    "normalized_remotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "matched_repo_id": {
      "type": ["string", "null"]
    },
    "matched_repo_group_id": {
      "type": ["string", "null"]
    },
    "binding_name": {
      "type": ["string", "null"]
    },
    "profile": {
      "type": ["string", "null"]
    },
    "repo_class": {
      "type": "string",
      "enum": ["client", "internal", "unknown"]
    },
    "layer_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["org", "repo-group", "repo", "user", "profile"]
      },
      "minItems": 1
    },
    "applied_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer_name", "identifier"],
        "properties": {
          "layer_name": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "enabled_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_details": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "namespace",
          "commit",
          "url",
          "checkout_path",
          "fingerprint",
          "fingerprint_mode",
          "trust_status"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["corp", "external", "user"]
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "minLength": 7
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "checkout_path": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint_mode": {
            "type": "string",
            "minLength": 1
          },
          "trust_status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "enabled_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_policies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_packs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_flows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_agent_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_profile_configs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profileConfig"
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/resolvedItem"
      }
    },
    "denied_items": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/resolvedItem"
      }
    }
  },
  "$defs": {
    "profileConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer_name", "status", "review_status", "autonomy_level"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layer_name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "archived"]
        },
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "reviewed", "approved"]
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["interactive", "supervised", "background", "autonomous"]
        },
        "requires_human_approval": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation_contact": {
          "type": "string",
          "minLength": 1
        },
        "allowed_tool_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_approval_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_tool_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "intended_consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["human", "cursor", "claude", "codex", "harness", "agent-os", "workflow-engine", "ci-governance"]
          }
        }
      }
    },
    "replacedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_type", "source_namespace", "source_ref"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": ["corp", "external", "user"]
        },
        "source_namespace": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "privacy",
        "source_type",
        "source_namespace",
        "source_ref",
        "slug",
        "status",
        "layer_name",
        "activated_by",
        "activation_reason",
        "overridden_by",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["skill", "policy", "doc", "contract", "flow", "pack", "profile"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "privacy": {
          "type": "string",
          "enum": ["corp-private", "repo-safe"]
        },
        "source_type": {
          "type": "string",
          "enum": ["corp", "external", "user"]
        },
        "source_namespace": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["direct", "replaced", "field-overridden"]
        },
        "lifecycle_status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "archived"]
        },
        "layer_name": {
          "type": "string",
          "minLength": 1
        },
        "activated_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "activation_reason": {
          "type": ["string", "null"],
          "enum": ["enabled", "required", null]
        },
        "activation_state": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "selected_by_packs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_by_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["claude", "codex", "cursor"]
          }
        },
        "privacy_status": {
          "type": "string",
          "enum": ["corp-private", "repo-safe"]
        },
        "trust_level": {
          "type": "string",
          "enum": ["unreviewed", "user-trusted", "corp-reviewed", "corp-required"]
        },
        "allows_scripts": {
          "type": "boolean"
        },
        "overridden_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active": {
          "type": "boolean"
        },
        "replaced_from": {
          "$ref": "#/$defs/replacedFrom"
        },
        "denied_reason": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_agent_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "source_note": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "reviewed", "approved"]
        },
        "deprecated_by": {
          "type": "string",
          "minLength": 1
        },
        "sunset_after": {
          "type": "string",
          "minLength": 1
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["interactive", "supervised", "background", "autonomous"]
        },
        "requires_human_approval": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation_contact": {
          "type": "string",
          "minLength": 1
        },
        "allowed_tool_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_approval_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_tool_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1
        },
        "applies_to_languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applies_to_frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compatible_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "repo_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["claude", "codex", "cursor"]
          }
        },
        "claude_model": {
          "type": "string",
          "minLength": 1
        },
        "cursor_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cursor_always_apply": {
          "type": "boolean"
        },
        "target_settings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/targetSettings"
          }
        },
        "policy_rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "usage_mode": {
          "type": "string",
          "enum": ["reusable", "one-time"]
        },
        "promotion_checklist": {
          "$ref": "#/$defs/promotionChecklist"
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "enabled": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "body": {
          "type": "string"
        }
      }
    }
    ,
    "targetSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "boolean"
        },
        "summary_budget": {
          "type": "string",
          "enum": ["short", "medium", "full"]
        },
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "always_apply": {
          "type": "boolean"
        }
      }
    },
    "promotionChecklist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "redundancy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-agents.local/schemas/item-toml-v1.schema.json",
  "title": "team-agents item.toml v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "privacy"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(corp|external|user)\\.([a-z0-9][a-z0-9_-]*)\\.(skill|policy|doc|contract|flow|pack|profile)\\.([a-z0-9][a-z0-9_-]*)$"
    },
    "kind": {
      "type": "string",
      "enum": ["skill", "policy", "doc", "contract", "flow", "pack", "profile"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "privacy": {
      "type": "string",
      "enum": ["corp-private", "repo-safe"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"]
    },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "reviewed", "approved"]
    },
    "deprecated_by": {
      "type": "string",
      "minLength": 1
    },
    "sunset_after": {
      "type": "string",
      "minLength": 1
    },
    "autonomy_level": {
      "type": "string",
      "enum": ["interactive", "supervised", "background", "autonomous"]
    },
    "requires_human_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation_contact": {
      "type": "string",
      "minLength": 1
    },
    "allowed_tool_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_approval_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_tool_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_agent_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "source_note": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "trust_level": {
      "type": "string",
      "enum": ["unreviewed", "user-trusted", "corp-reviewed", "corp-required"]
    },
    "allows_scripts": {
      "const": false
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "applies_to_languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applies_to_frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatible_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "repo_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["claude", "codex", "cursor"]
      }
    },
    "claude_model": {
      "type": "string",
      "minLength": 1
    },
    "cursor_globs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cursor_always_apply": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "$ref": "#/$defs/targetSettings"
        },
        "codex": {
          "$ref": "#/$defs/targetSettings"
        },
        "cursor": {
          "$ref": "#/$defs/targetSettings"
        }
      }
    },
    "policy_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule"],
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "local_user_layer_must_be_git_backed",
              "required_skill_ids",
              "required_contract_ids",
              "forbidden_source_patterns"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["warn", "fail"]
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "usage_mode": {
      "type": "string",
      "enum": ["reusable", "one-time"]
    },
    "promotion_checklist": {
      "$ref": "#/$defs/promotionChecklist"
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(corp|external|user)\\.([a-z0-9][a-z0-9_-]*)\\.(policy|contract|pack)\\.([a-z0-9][a-z0-9_-]*)$"
          }
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(corp|external|user)\\.([a-z0-9][a-z0-9_-]*)\\.(skill|policy|doc|contract|flow|pack)\\.([a-z0-9][a-z0-9_-]*)$"
          }
        }
      }
    }
  },
  "$defs": {
    "targetSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "boolean"
        },
        "summary_budget": {
          "type": "string",
          "enum": ["short", "medium", "full"]
        },
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "always_apply": {
          "type": "boolean"
        }
      }
    },
    "promotionChecklist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "redundancy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-agents.local/schemas/v1/activation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "$ref": "#/$defs/idList"
    },
    "required": {
      "$ref": "#/$defs/idList"
    },
    "disabled": {
      "$ref": "#/$defs/idList"
    },
    "recommended": {
      "$ref": "#/$defs/idList"
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

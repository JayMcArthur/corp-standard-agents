{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-agents.local/schemas/v1/profile-job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"]
    },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "reviewed", "approved"]
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "intended_consumers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["human", "cursor", "claude", "codex", "ci-governance"]
      }
    },
    "skills": {
      "$ref": "activation.schema.json"
    },
    "policies": {
      "$ref": "activation.schema.json"
    },
    "contexts": {
      "$ref": "activation.schema.json"
    },
    "completion_gates": {
      "$ref": "activation.schema.json"
    },
    "packs": {
      "$ref": "activation.schema.json"
    },
    "playbooks": {
      "$ref": "activation.schema.json"
    },
    "profiles": {
      "$ref": "activation.schema.json"
    },
    "recommended_agent_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
